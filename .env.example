# Solana RPC — server-side (private, preferred for API routes — API key not exposed to browser)
SOLANA_RPC=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Solana RPC — client-side (used by WalletProvider in the browser)
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Supabase - Get these from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
