# Solana RPC — server-side (private, preferred for API routes — API key not exposed to browser)
SOLANA_RPC=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Solana RPC — client-side (used by WalletProvider in the browser)
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Supabase — Get these from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL — used for absolute URL generation (OAuth callbacks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development only — set to true to skip wallet signature verification
SKIP_SIG_VERIFY=false
